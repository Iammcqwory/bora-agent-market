# Binance B402 partner credentials are issued separately for Testnet and Production.
B402_ENVIRONMENT=testnet
B402_NETWORK=eip155:97
B402_API_VERSION=v2
B402_API_BASE_URL=
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_API_PRIVATE_KEY_PATH=
B402_WEBHOOK_PUBLIC_KEY=

# Restrict the first integration to one verified configuration.
B402_ALLOWED_ASSET=USDT
B402_ALLOWED_METHOD=permit2-exact
B402_ALLOWED_PAY_TO=

DATABASE_URL=
